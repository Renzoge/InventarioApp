<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bg_tarjeta"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/borde_sutil"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Producto y Total Cobrado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtHistProducto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Martillo"
                android:textColor="@color/texto_principal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHistTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/verde_fondo"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="S/ 23.00"
                android:textColor="@color/verde_exito"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cantidad y Código -->
        <TextView
            android:id="@+id/txtHistDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="2 unidades • Cód. #5343"
            android:textColor="@color/texto_principal"
            android:textSize="14sp" />

        <!-- Fecha y hora -->
        <TextView
            android:id="@+id/txtHistFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="19/11/2026 17:11"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
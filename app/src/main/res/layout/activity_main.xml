<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Punto de Venta - Ferretería"
            android:textColor="#0077B6"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Fila Código + Cámara + Buscar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/txtCodigoVenta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Código del producto"
                android:inputType="text" />

            <ImageButton
                android:id="@+id/btnCamaraVenta"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Escanear"
                android:src="@android:drawable/ic_menu_camera" />

            <Button
                android:id="@+id/btnBuscarVenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Buscar" />
        </LinearLayout>

        <!-- Cuadro informativo del producto encontrado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#F1F5F9"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/lblNombreVenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Producto: "
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblCategoriaVenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Categoría: "
                android:textSize="14sp" />

            <TextView
                android:id="@+id/lblPrecioVenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Precio Unitario: S/ 0.00"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/lblStockVenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Stock disponible: 0"
                android:textColor="#0077B6"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cantidad a vender -->
        <EditText
            android:id="@+id/txtCantidadVenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Cantidad a vender"
            android:inputType="number" />

        <!-- Total a cobrar -->
        <TextView
            android:id="@+id/lblTotalVenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="end"
            android:text="Total a cobrar: S/ 0.00"
            android:textColor="#1B4332"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConfirmarVenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmar Venta" />

    </LinearLayout>
</ScrollView>